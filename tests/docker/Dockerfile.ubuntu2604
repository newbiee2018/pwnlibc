FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y \
        python3 python3-pip patchelf binutils zstd gcc libc6-dev \
        gdb gdb-multiarch \
        qemu-user-static \
        gcc-aarch64-linux-gnu \
        gcc-arm-linux-gnueabihf \
        gcc-powerpc64le-linux-gnu \
        gcc-s390x-linux-gnu \
        gcc-riscv64-linux-gnu \
        gcc-mipsel-linux-gnu \
        gcc-mips64el-linux-gnuabi64 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /pwnlibc
COPY requirements.txt .
RUN pip3 install --break-system-packages -r requirements.txt 2>/dev/null || pip3 install -r requirements.txt
RUN pip3 install --break-system-packages pytest 2>/dev/null || pip3 install pytest

COPY . .
ENV PYTHONPATH=/pwnlibc
CMD ["python3", "-m", "pytest", "tests/", "-v", "--tb=short", "-m", "not network and not slow"]
